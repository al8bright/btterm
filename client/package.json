{
  "name": "btterm-client",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --project core --project ui --project desktop --project scripts",
    "test:watch": "vitest --project core --project ui --project desktop",
    "check:ac": "node scripts/check-ac-matrix.mjs",
    "verify": "pnpm lint && pnpm lint:deps && pnpm lint:css && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:ac && pnpm check:secrets && pnpm check:licenses && pnpm check:audit",
    "test:integration": "vitest run --project integration",
    "verify:full": "pnpm verify && pnpm test:integration && pnpm test:e2e",
    "test:e2e": "pnpm --filter @btterm/desktop build:e2e && pnpm --filter @btterm/desktop test:e2e",
    "dev": "pnpm --filter @btterm/desktop dev",
    "postinstall": "node scripts/ensure-electron.mjs",
    "lint:deps": "depcruise core/src ui/src desktop/src --config .dependency-cruiser.cjs",
    "lint:css": "stylelint \"*/src/**/*.css\" --allow-empty-input",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:audit": "pnpm audit --prod --audit-level high",
    "check:fuses": "node scripts/check-fuses.mjs",
    "package:win": "node scripts/package-win.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "release": "node scripts/release.mjs",
    "test:perf": "pnpm --filter @btterm/desktop build:e2e && pnpm --filter @btterm/desktop test:perf",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
